# Block 3. Build this, then go looking for the file that was deleted.
#
#   docker build -f solutions/Dockerfile.leaky -t snake:leaky app
#   docker history snake:leaky
#   docker save snake:leaky -o /tmp/leaky.tar
#   mkdir -p /tmp/leaky && tar -xf /tmp/leaky.tar -C /tmp/leaky
#   grep -r "SUPER_SECRET" /tmp/leaky 2>/dev/null
#
# The RUN below removes the file. An image is a stack of layers, and a deletion
# is just one more layer on top saying "this is gone". Everything underneath is
# still there, and anyone who can pull the image can read it.

FROM node:22-alpine
WORKDIR /app
COPY . .
RUN rm -f .env
CMD ["node", "server.js"]
