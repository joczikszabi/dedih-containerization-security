# Where block 2 and block 3 end up. Roughly 15 times smaller than the starting
# point, and it does not run as root.
#
# The build stage carries the whole toolchain: vite, typescript, every
# devDependency. None of it ships, because the runtime stage only copies the
# built output across.

FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:22-alpine AS runtime
WORKDIR /app

ENV NODE_ENV=production

# Production dependencies only. express and pg, nothing else.
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY --from=build /app/dist ./dist
COPY server.js ./
COPY lib ./lib

ARG IMAGE_TAG=snake:v2
ENV IMAGE_TAG=$IMAGE_TAG

# node:alpine ships a `node` user with uid 1000. Using it costs nothing and
# means a process escaping the application is not root inside the container.
USER node

EXPOSE 3000
CMD ["node", "server.js"]
